APP_NAME="jevidocs API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://127.0.0.1:4730
APP_HOST=127.0.0.1
APP_PORT=4730

# Where apps/site serves the docs reader.
SITE_URL=http://127.0.0.1:4720
# First admin, created on start when there are no users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

JWT_SECRET=

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

DB_CONNECTION=postgres
# Local Postgres from infra/dev/compose.yml (`task db:up`).
DB_HOST=127.0.0.1
DB_PORT=4732
DB_DATABASE=jevidocs
DB_USERNAME=jevidocs
DB_PASSWORD=jevidocs
DB_MIGRATE_ON_START=true

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Ask AI in the docs reader (optional; off without a key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
